---
import Sidebar from "../../components/Sidebar.astro";
import PageLoader from "../../components/PageLoader.astro";
import FloatingTanghulu from "../../components/FloatingTanghulu.astro";

const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
);


function getExcerpt(post) {
  let content = "";

  try {
    content = typeof post.rawContent === "function"
      ? post.rawContent()
      : "";
  } catch {}

  content = content
    .replace(/^---[\s\S]*?---\s*/, "")
    .replace(/```[\s\S]*?```/g, "")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, "")
    .replace(/^\s{0,3}#{1,6}\s+/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*>\s?/gm, "")
    .replace(/[*_~]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return content.length > 100
    ? content.slice(0, 100).trim() + "…"
    : content;
}


---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>DAILY LIFE / IZUMI</title>
  </head>

  <body>
    <PageLoader />
    <FloatingTanghulu />
    <main class="page">

      <Sidebar />

      <div class="daily-main">
      <section class="intro">
        <p>01</p>

        <h1>
          碎碎念
        </h1>

        <p class="description">
          没什么大事，胡思乱想先放这里。
        </p>
      </section>

      <div class="daily-content-layout">
        <section class="posts">
          {posts.map((post) => (
            <a href={post.url} class="post" id={`post-${post.frontmatter.date}-${post.frontmatter.title}`}>
              {post.frontmatter.cover && (
                <div class="post-cover">
                  <img src={post.frontmatter.cover} alt="" loading="lazy" />
                  <div class="post-cover-gradient"></div>
                </div>
              )}

              <div class="post-info">
                <div class="post-date">{post.frontmatter.date}</div>
                <div class="post-main">
                  <h2>{post.frontmatter.title}</h2>
                  <p>{post.frontmatter.description}</p>
                  <p class="post-excerpt">{getExcerpt(post)}</p>
                </div>
                <div class="post-card-bottom">继续阅读 <span>↗</span></div>
              </div>
            </a>
          ))}
        </section>

        <aside class="post-timeline">
          <p class="timeline-label">TIMELINE / 时间轴</p>
          {Object.entries(
            posts.reduce((groups, post) => {
              const year = String(post.frontmatter.date || "").slice(0, 4) || "其他";
              (groups[year] ||= []).push(post);
              return groups;
            }, {})
          ).sort(([a], [b]) => b.localeCompare(a)).map(([year, yearPosts]) => (
            <div class="timeline-year">
              <h3>{year}</h3>
              {yearPosts.sort((a, b) =>
                String(b.frontmatter.date || "").localeCompare(String(a.frontmatter.date || ""))
              ).map((post) => (
                <a href={`${post.url}`} class="timeline-item">
                  <span class="timeline-dot"></span>
                  <span class="timeline-date">{post.frontmatter.date}</span>
                  <span class="timeline-title">{post.frontmatter.title}</span>
                </a>
              ))}
            </div>
          ))}
        </aside>

        <nav class="side-categories" aria-label="文章分类">
          <p class="side-categories-label">CATEGORIES / 分类</p>
          <a href={`${import.meta.env.BASE_URL}daily/`} class="side-category">
            <span class="side-category-en">01</span>
            <span class="side-category-name">碎碎念</span>
            <span class="side-category-desc">没什么大事，胡思乱想先放这里。</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}travel/`} class="side-category">
            <span class="side-category-en">02</span>
            <span class="side-category-name">到处乱跑</span>
            <span class="side-category-desc">先出门再说。</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}subtitles/`} class="side-category">
            <span class="side-category-en">03</span>
            <span class="side-category-name">听写小作坊</span>
            <span class="side-category-desc">偶尔也怀疑自己的耳朵。</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}works/`} class="side-category">
            <span class="side-category-en">04</span>
            <span class="side-category-name">书影音游</span>
            <span class="side-category-desc">喜欢什么就往这里丢。</span>
          </a>
        </nav>
      </div>

      <footer class="site-footer">
        <p>This blog is live for <span id="blog-live-time">0 days, 0 hours, 0 mins</span> and counting.</p>
        <p>Copyright © 2026 IZUMI · 糖葫芦</p>
      </footer>
      </div>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    width: min(1600px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 36px;
    box-sizing: border-box;
  }

  .daily-main {
    min-width: 0;
    width: 100%;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #35495E;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  nav a:hover,
  .back:hover {
    color: #7CB1D2;
  }

  .intro {
    padding: 45px 0 55px;
  }

  .intro h1 {
    margin-bottom: 8px;
  }

  .intro .description {
    margin-top: 0;
  }

  .intro > p:first-child {
    margin: 0 0 30px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 13px;
  }

  h1 {
    margin: 0;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .description {
    margin-top: 35px;
    color: #667B7F;
    font-size: 17px;
  }

  .section-title {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 1px solid #35495E;
    border-bottom: 1px solid #CFE3EF;
    font-family: monospace;
    font-size: 13px;
  }

  .section-title span:last-child {
    color: #7CB1D2;
  }

  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    align-self: start;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: rgba(255,255,255,.88);
    border: 1px solid #DCEAF0;
    border-radius: 14px;
    box-shadow: 0 5px 20px rgba(75,110,130,.045);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  .post:hover {
    color: #7CB1D2;
    transform: translate(-8px, -2px);
    border-color: #79C9C3;
    background: rgba(241, 250, 248, 0.82);
  }

  .date {
    font-family: monospace;
    color: #849A98;
    font-size: 13px;
  }

  .main h2 {
    margin: 0 0 10px;
    font-size: 25px;
    font-weight: 500;
  }

  .main p {
    margin: 0;
    color: #849A98;
    font-size: 14px;
  }

  .arrow {
    font-size: 22px;
  }

  .back {
    display: inline-block;
    margin-top: 80px;
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 100px;
    padding-top: 20px;
    border-top: 1px solid #35495E;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  @media (max-width: 700px) {
    .page {
      padding: 30px 20px;
    }

    header {
      align-items: flex-start;
    }

    nav {
      gap: 15px;
    }

    .intro {
      padding: 80px 0;
    }

    .post {
      grid-template-columns: 1fr 25px;
      gap: 10px;
    }

    .date {
      grid-column: 1 / -1;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }

  .post-timeline .side-categories {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    gap: 10px !important;
  }

  .post-timeline .side-categories-label {
    display: block !important;
    width: 100% !important;
  }

  .post-timeline a.side-category {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    white-space: nowrap !important;
    writing-mode: horizontal-tb !important;
  }

  .post-timeline .side-category-name,
  .post-timeline .side-category-en {
    display: inline-block !important;
    writing-mode: horizontal-tb !important;
  }

</style>


<style>
  .daily-content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 34px;
    align-items: start;
  }

  .posts {
    columns: 2;
    column-gap: 22px;
    min-width: 0;
  }

  .posts .post {
    break-inside: avoid;
    margin: 0 0 22px;
    width: 100%;
  }

  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: rgba(255,255,255,.78);
    border: 1px solid #DCEAF0;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(75,110,130,.045);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  .post:hover {
    transform: translateY(-4px);
    border-color: #B7D5E5;
    box-shadow: 0 12px 28px rgba(75,110,130,.12);
  }

  .post-cover {
    position: relative;
    display: block;
    flex: 0 0 190px;
    width: 100%;
    height: 190px;
    box-sizing: border-box;
    overflow: hidden;
    background: #EAF4F8;
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .post:hover .post-cover img {
    transform: scale(1.04);
  }

  .post-info {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    z-index: 1;
    width: 100%;
    min-width: 0;
    margin-left: 0;
    padding: 17px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 11px;
    box-sizing: border-box;
  }

  .post-date {
    color: #849A98;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: .04em;
  }

  .post-main {
    display: block;
    min-width: 0;
    width: 100%;
  }

  .post-main h2 {
    display: block;
    visibility: visible;
    opacity: 1;
    position: relative;
    margin: 0 0 9px;
    color: #35495E;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .post-main p {
    margin: 0;
    color: #849A98;
    font-size: 13px;
    line-height: 1.8;
  }

  .post-main .post-excerpt {
    display: -webkit-box;
    margin-top: 40px;
    overflow: hidden;
    color: #667B7F;
    font-size: 12px;
    line-height: 1.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-card-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 12px;
    color: #7CB1D2;
    font-size: 12px;
    border-top: 1px solid #EAF2F5;
  }

  .post-card-bottom span {
    font-size: 15px;
  }

  .post-timeline {
    position: fixed;
    top: 40px;
    right: 28px;
    width: 192px;
    max-height: calc(100vh - 16px);
    z-index: 20;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #CFE3EF transparent;
    border-left: 1px solid #CFE3EF;
    padding-left: 18px;
    min-width: 0;
  }

  .post-timeline::-webkit-scrollbar {
    width: 4px;
  }

  .post-timeline::-webkit-scrollbar-thumb {
    background: #CFE3EF;
    border-radius: 4px;
  }

  .timeline-label {
    margin: 0 0 22px;
    color: #7CB1D2;
    font-size: 10px;
    letter-spacing: .13em;
  }

  .side-categories {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid #CFE3EF;
  }

  .side-categories-label {
    margin: 0 0 5px;
    color: #7CB1D2;
    font-size: 10px;
    letter-spacing: .13em;
  }

  .side-category {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 15px 16px;
    color: #35495E;
    text-decoration: none;
    white-space: nowrap;
    writing-mode: horizontal-tb;
    background: #FFFFFF;
    border: 1px solid #CDE3EF;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(124, 177, 210, 0.08);
    font-size: 15px;
    transition: all 0.2s ease;
  }

  .side-category:hover {
    color: #7CB1D2;
    background: rgba(241, 250, 248, 0.82);
    border-color: #79C9C3;
    transform: translateY(-2px);
  }

  .side-category-en {
    flex-shrink: 0;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 10px;
    writing-mode: horizontal-tb;
  }

  .side-category-name {
    font-size: 15px;
    writing-mode: horizontal-tb;
  }

  .side-category-desc {
    display: none;
  }

  .side-category::after {
    content: "";
    position: absolute;
    top: 7px;
    right: 7px;
    bottom: 7px;
    width: 4px;
    border-radius: 4px;
    background: #7CB1D2;
  }

  .side-category:nth-of-type(2)::after {
    background: #86C5FF;
  }

  .side-category:nth-of-type(3)::after {
    background: #FFA62B;
  }

  .side-category:nth-of-type(4)::after {
    background: #F8E6A0;
  }

  .timeline-year {
    margin-bottom: 22px;
  }

  .timeline-year h3 {
    margin: 0 0 12px;
    color: #35495E;
    font-size: 19px;
    font-weight: 500;
  }

  .timeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 0 15px 4px;
    padding-left: 16px;
    color: inherit;
    text-decoration: none;
  }

  .timeline-item::before {
    position: absolute;
    top: 4px;
    bottom: -16px;
    left: 3px;
    width: 1px;
    background: #DCEAF0;
    content: "";
  }

  .timeline-dot {
    position: absolute;
    top: 4px;
    left: 0;
    z-index: 1;
    width: 7px;
    height: 7px;
    border: 1px solid #7CB1D2;
    border-radius: 50%;
    background: #F8FCFB;
  }

  .timeline-item:hover .timeline-dot {
    background: #7CB1D2;
  }

  .timeline-date {
    color: #91A6AA;
    font-family: monospace;
    font-size: 10px;
  }

  .timeline-title {
    color: #526B7D;
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1050px) {
    .daily-content-layout {
      grid-template-columns: minmax(0, 1fr) 170px;
      gap: 18px;
    }

    .posts {
      column-gap: 14px;
    }

    .post-cover {
      height: 155px;
    }
  }

  @media (max-width: 760px) {
    .daily-content-layout {
      grid-template-columns: 1fr;
    }

    .posts {
      columns: 2;
      column-gap: 12px;
    }

    .posts .post {
      margin-bottom: 12px;
    }

    .post-cover {
      height: 145px;
    }

    .post-info {
      padding: 12px;
      gap: 9px;
    }

    .post-main h2 {
      font-size: 16px;
    }

    .post-main p {
      font-size: 12px;
    }

    .post-timeline {
      position: static;
      border-left: 0;
      border-top: 1px solid #CFE3EF;
      margin-top: 22px;
    }
  }

  @media (max-width: 420px) {
    .posts {
      columns: 1;
    }

    .post-cover {
      height: 200px;
    }
  }

  .post-timeline .side-categories {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    gap: 10px !important;
  }

  .post-timeline .side-categories-label {
    display: block !important;
    width: 100% !important;
  }

  .post-timeline a.side-category {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    white-space: nowrap !important;
    writing-mode: horizontal-tb !important;
  }

  .post-timeline .side-category-name,
  .post-timeline .side-category-en {
    display: inline-block !important;
    writing-mode: horizontal-tb !important;
  }

</style>

