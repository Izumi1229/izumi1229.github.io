---
import PageLoader from "../components/PageLoader.astro";
import Sidebar from "../components/Sidebar.astro";
import FloatingTanghulu from "../components/FloatingTanghulu.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>ABOUT / IZUMI'S BLOG</title>
  </head>

  <body>
    <PageLoader />
    <FloatingTanghulu />
    <main class="page">
      <Sidebar />

      <div class="about-main">
      <section class="about">
        <p class="label">ABOUT / 01</p>

        <h1 class="about-name">
          你好，我是 Izumi，也可以叫我糖葫芦。
        </h1>

        <div class="text">
          <p>这里是一个什么都想记一点的小角落！</p>

          <p>言語○ CN / EN / JP</p>

          <p>日本の大学院進学準備中</p>

          <p>
            喜欢小说漫画<br />
            对HSJ上头中<br />
            热衷于给自己的娃买新衣服
          </p>

          <p>
            这里可能会出现：<br />
            · 一些生活碎片<br />
            · 半吊子字幕小作坊的制作记录<br />
            · 最近在看的漫画小说
          </p>


          <p>
            欢迎和我交换友链 ♡<br />
            留言格式请参考<a href="/friends/">友链</a>。<br />
            也可通过邮箱：iiizumi1229@163.com来联系我<br />
            欢迎在文章下留言！看到评论的话会很开心 (´▽｀)
          </p>

          <p>博客头像是很好的同担姐姐给我做的视频水印，越看越喜欢，觉得拿来当头像也很合适，于是就有了这个糖葫芦博客！</p>

          <p class="small">&gt; 長い夜に朝日が差した♪ &lt;</p>
        </div>
      </section>

      <section class="contact">
        <p class="label">CONTACT / 01</p>

        <div class="contact-links">
          <a
            class="contact-item"
            href="https://xhslink.cn/o/4YKjjKWoeoF"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="小红书"
          >
            <span class="contact-icon xhs-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="22" fill="#F6A6B5" stroke="none"/>
          <rect x="13" y="14" width="22" height="21" rx="7" fill="none" stroke="#FFF" stroke-width="1.8"/>
          <path d="M18 22c2 1.5 4 1.5 6 0M18 27c2 1.5 4 1.5 6 0M28 22h3M28 27h3" fill="none" stroke="#FFF" stroke-width="1.7" stroke-linecap="round"/>
          <path d="M15 9l-1-3M32 9l2-3" fill="none" stroke="#FFF" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </span>
            <span class="contact-name">小红书</span>
          </a>

          <a
            class="contact-item"
            href="https://b23.tv/2GVGELf"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="哔哩哔哩"
          >
            <span class="contact-icon bili-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="22" fill="#8BD3EE" stroke="none"/>
          <rect x="11" y="15" width="26" height="20" rx="7" fill="none" stroke="#FFF" stroke-width="1.8"/>
          <path d="M17 12l-3-4M31 12l3-4M18 23v4M30 23v4" fill="none" stroke="#FFF" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M19 30c2 1 4 1 5 0" fill="none" stroke="#FFF" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
            <span class="contact-name">Bilibili</span>
          </a>

          <a
            class="contact-item"
            href="https://x.com/mushanbiu?s=11"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X"
          >
            <span class="contact-icon x-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="22" fill="#71829E" stroke="none"/>
          <path d="M14 13l20 22M34 13L14 35" fill="none" stroke="#FFF" stroke-width="2.1" stroke-linecap="round"/>
          <path d="M36 10l1-3M40 14l3-1" fill="none" stroke="#FFF" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </span>
            <span class="contact-name">X</span>
          </a>

      

          <a
            class="contact-item"
            href="/rss.xml"
            aria-label="RSS"
          >
            <span class="contact-icon rss-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="22" fill="#F2B45B" stroke="none"/>
          <circle cx="15" cy="33" r="2" fill="#FFF" stroke="none"/>
          <path d="M15 25c4.5 0 8 3.5 8 8M15 17c8.8 0 16 7.2 16 16" fill="none" stroke="#FFF" stroke-width="1.9" stroke-linecap="round"/>
          <path d="M35 11l1-3M40 15l3-1" fill="none" stroke="#FFF" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </span>
            <span class="contact-name">RSS</span>
          </a>
        </div>
      </section>

      <footer class="site-footer">
        <p>This blog is live for <span id="blog-duration">0 days, 0 hours, 0 mins</span> and counting.</p>
        <p>Copyright © 2026 IZUMI · 糖葫芦</p>
      </footer>
      </div>
    </main>
  


  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    position: relative;
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", sans-serif;
  }

  :global(body)::after {
    content: "";
    position: fixed;
    right: 35px;
    bottom: 35px;
    width: 180px;
    height: 180px;
    background: url("/images/akisou-tanghulu.png") center / contain no-repeat;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }

  .page {
    width: min(1400px, calc(100% - 60px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 55px;
  }

  .sidebar {
    position: sticky;
    top: 45px;
    height: calc(100vh - 90px);
    align-self: start;
    display: flex;
    flex-direction: column;
  }

  .side-logo {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: #35495E;
    text-decoration: none;
  }

  .side-logo img {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    object-fit: cover;
  }

  .side-logo span {
    font-family: monospace;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .side-intro {
    margin-top: 32px;
  }

  .side-intro .hello {
    margin: 0 0 18px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 11px;
  }

  .side-intro h1 {
    margin: 0;
    color: #35495E;
    font-size: 25px;
    line-height: 1.15;
    font-weight: 500;
  }

  .side-intro h1 span {
    color: #7CB1D2;
  }

  .side-intro .description {
    margin: 18px 0 0;
    color: #667B7F;
    font-size: 12px;
    line-height: 1.7;
  }

  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 42px;
  }

  .side-nav a {
    color: #849A98;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
  }

  .side-nav a:hover {
    color: #7CB1D2;
  }

  .sidebar-contact {
    margin-top: 42px;
  }

  .sidebar-contact p {
    margin: 0 0 16px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 11px;
  }

  .sidebar-contact .contact-links {
    display: flex;
    gap: 5px;
  }

  .sidebar-contact .contact-links a {
    width: 38px;
    height: 38px;
  }

  .sidebar-contact .contact-links img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .about-main {
    min-width: 0;
    min-height: calc(100vh - 90px);
    display: flex;
    flex-direction: column;
  }

  .about {
    max-width: 680px;
    padding-top: 5px;
  }

  .label {
    margin: 0 0 32px;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #7CB1D2;
  }

  .about-avatar {
    display: block;
    width: 64px;
    height: 64px;
    margin: 0 0 22px;
    border-radius: 50%;
    object-fit: cover;
  }

  .about-name {
    margin: 0;
    font-size: 28px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #7CB1D2;
  }

  .text {
    margin-top: 45px;
    margin-left: 0;
    max-width: 680px;
    font-size: 15px;
    line-height: 2;
    color: #667B7F;
  }

  .text p {
    margin: 0 0 28px;
  }

  .text .small {
    margin-top: 60px;
    font-family: monospace;
    font-size: 13px;
    color: #35495E;
  }

  .contact {
    display: none;
  }

  .contact a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  .contact a:hover {
    color: #7CB1D2;
  }

  .contact-links {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 128px;
    height: 46px;
    padding: 0 18px;
    border: 1.5px solid #D6E8EF;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    color: #35495E;
    text-decoration: none;
    box-sizing: border-box;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .contact-item:hover {
    transform: translateY(-3px);
    background: #FFFFFF;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
  }

  .contact-icon svg {
    width: 25px;
    height: 25px;
    display: block;
  }

  .contact-name {
    font-family: monospace;
    font-size: 13px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: inherit;
  }

  .contact-item:has(.xhs-icon) .contact-name {
    color: #E9899F;
  }

  .contact-item:has(.bili-icon) .contact-name {
    color: #69BBD8;
  }

  .contact-item:has(.x-icon) .contact-name {
    color: #657894;
  }

  .contact-item:has(.wechat-icon) .contact-name {
    color: #72B886;
  }

  .contact-item:has(.rss-icon) .contact-name {
    color: #E7A34D;
  }

  .xhs-icon {
    color: #E9899F;
  }

  .bili-icon {
    color: #69BBD8;
  }

  .x-icon {
    color: #657894;
  }

  .wechat-icon {
    color: #72B886;
  }

  .rss-icon {
    color: #E7A34D;
  }

  .contact-item:has(.xhs-icon) {
    border-color: #E9B4C0;
  }

  .contact-item:has(.bili-icon) {
    border-color: #A8D9E9;
  }

  .contact-item:has(.x-icon) {
    border-color: #AAB6C8;
  }

  .contact-item:has(.wechat-icon) {
    border-color: #ABD6B5;
  }

  .contact-item:has(.rss-icon) {
    border-color: #EBC98F;
  }

  .wechat-item {
    cursor: pointer;
    font: inherit;
  }

  .copy-tip {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translate(-50%, 10px);
    padding: 8px 16px;
    border: 1px solid #ABD6B5;
    border-radius: 999px;
    background: #F8FCFB;
    color: #72B886;
    font-family: monospace;
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 1000;
  }

  .copy-tip.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .back {
    display: inline-block;
    margin-top: 65px;
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
  }

  footer {
    margin-top: auto;
    padding-top: 25px;
    border-top: 1px solid #35495E;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  @media (max-width: 700px) {
    .page {
      padding: 35px 20px;
    }

    header {
      display: block;
      margin-bottom: 60px;
    }

    nav {
      margin-top: 25px;
      gap: 16px;
    }

    .about {
      max-width: none;
    }

    .text {
      margin-left: 0;
      margin-top: 50px;
      font-size: 16px;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }

  .about-main .text a {
    color: #6B9FBE;
    text-decoration: underline;
    text-decoration-color: #CFE3EF;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color .2s ease, text-decoration-color .2s ease;
  }

  .about-main .text a:hover {
    color: #35495E;
    text-decoration-color: #7CB1D2;
  }

</style>

<script>
  const blogStart = new Date("2026-10-03T00:00:00+08:00");
  const liveTime = document.querySelector("#blog-duration");

  function updateBlogLiveTime() {
    if (!liveTime) return;

    const diff = Date.now() - blogStart.getTime();
    const totalMinutes = Math.floor(diff / 60000);

    const days = Math.floor(totalMinutes / 1440);
    const hours = Math.floor((totalMinutes % 1440) / 60);
    const minutes = totalMinutes % 60;

    liveTime.textContent = `${days} days, ${hours} hours, ${minutes} mins`;
  }

  updateBlogLiveTime();
  setInterval(updateBlogLiveTime, 60000);
</script>
