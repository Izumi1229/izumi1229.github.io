---
import Sidebar from "../../components/Sidebar.astro";
import PageLoader from "../../components/PageLoader.astro";
import FloatingTanghulu from "../../components/FloatingTanghulu.astro";

const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).sort((a, b) =>
  String(b.frontmatter.date || "").localeCompare(
    String(a.frontmatter.date || "")
  )
);

const categories = [
  { label: "全部", value: "all" },
  { label: "电影", value: "movie" },
  { label: "电视剧", value: "tv" },
  { label: "书籍", value: "book" },
  { label: "音乐", value: "music" },
  { label: "游戏", value: "game" },
];

function getType(post) {
  return post.frontmatter.type || "other";
}

function getRating(post) {
  return Number(post.frontmatter.rating || 0);
}

function getTypeName(type) {
  return {
    movie: "电影",
    tv: "电视剧",
    book: "书籍",
    music: "音乐",
    game: "游戏",
  }[type] || "其他";
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F8FCFB" />
    <title>THE COLLECTION / IZUMI</title>
    <meta name="description" content="我的私人书影音游收藏馆。" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
  </head>

  <body>
    <PageLoader />
    <FloatingTanghulu />

    <main class="page">
      <Sidebar />

      <div class="collection">
        <header class="collection-header">
          <div>
            <p class="eyebrow">PERSONAL ARCHIVE <span>✳</span> 04</p>
            <h1>书影音游<span class="title-dot">.</span></h1>
            <p class="subtitle">一些看过、听过、读过，以及玩过的东西。</p>
          </div>
          <div class="collection-count">
            <span class="count-number">{String(posts.length).padStart(2, "0")}</span>
            <span class="count-label">COLLECTED</span>
          </div>
        </header>

        <section class="collection-tools">
          <div class="filter-group" id="type-filters">
            {categories.map((item, index) => (
              <button
                class:list={["filter-button", { active: index === 0 }]}
                data-type={item.value}
                type="button"
              >
                {item.label}
              </button>
            ))}
          </div>

          <div class="filter-bottom">
            <div class="rating-filters" id="rating-filters">
              <button class="rating-button active" data-rating="all" type="button">
                全部评分
              </button>
              <button class="rating-button" data-rating="4" type="button">
                ★ 4+
              </button>
              <button class="rating-button" data-rating="5" type="button">
                ★ 5
              </button>
            </div>

            <label class="search-box">
              <span>⌕</span>
              <input id="collection-search" type="search" placeholder="搜索作品..." />
            </label>
          </div>
        </section>

        <div class="result-bar">
          <span>THE COLLECTION</span>
          <span><b id="result-count">{posts.length}</b> ITEMS</span>
        </div>

        <section class="poster-grid" id="poster-grid">
          {posts.map((post) => {
            const type = getType(post);
            const rating = getRating(post);
            const cover = post.frontmatter.cover;

            return (
              <a
                class="poster-card"
                href={post.url}
                data-type={type}
                data-rating={rating}
                data-title={String(post.frontmatter.title || "").toLowerCase()}
              >
                <div class="poster-image">
                  {cover ? (
                    <img src={cover} alt={post.frontmatter.title || ""} loading="lazy" />
                  ) : (
                    <div class="poster-placeholder">
                      <span>IZUMI'S</span>
                      <span>COLLECTION</span>
                    </div>
                  )}
                  <div class="poster-overlay">
                    <span>VIEW DETAILS ↗</span>
                  </div>
                  {rating > 0 && (
                    <span class="poster-rating">★ {rating.toFixed(1)}</span>
                  )}
                </div>

                <div class="poster-info">
                  <div class="poster-meta">
                    <span>{getTypeName(type)}</span>
                    <span>{post.frontmatter.date || ""}</span>
                  </div>
                  <h2>{post.frontmatter.title}</h2>
                  {post.frontmatter.description && (
                    <p>{post.frontmatter.description}</p>
                  )}
                </div>
              </a>
            );
          })}
        </section>

        <div class="empty-state" id="empty-state" hidden>
          <span class="empty-symbol">✳</span>
          <p>这里暂时还没有收藏。</p>
          <span>MORE STORIES TO COME.</span>
        </div>

        <footer class="collection-footer">
          <span>KEEPING LITTLE THINGS THAT MATTER.</span>
          <span>IZUMI © 2026</span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script>
  const typeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".filter-button")
  );
  const ratingButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".rating-button")
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".poster-card")
  );
  const searchInput = document.querySelector<HTMLInputElement>(
    "#collection-search"
  );
  const resultCount = document.querySelector("#result-count");
  const emptyState = document.querySelector<HTMLElement>("#empty-state");

  let selectedType = "all";
  let selectedRating = "all";

  function filterCards() {
    const keyword = (searchInput?.value || "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const type = card.dataset.type || "other";
      const rating = Number(card.dataset.rating || 0);
      const title = card.dataset.title || "";

      const matchType =
        selectedType === "all" || type === selectedType;

      const matchRating =
        selectedRating === "all" ||
        (selectedRating === "4" && rating >= 4) ||
        (selectedRating === "5" && rating >= 5);

      const matchSearch = title.includes(keyword);
      const visible = matchType && matchRating && matchSearch;

      card.hidden = !visible;
      if (visible) visibleCount++;
    });

    if (resultCount) resultCount.textContent = String(visibleCount);
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  }

  typeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      selectedType = button.dataset.type || "all";
      typeButtons.forEach((item) =>
        item.classList.toggle("active", item === button)
      );
      filterCards();
    });
  });

  ratingButtons.forEach((button) => {
    button.addEventListener("click", () => {
      selectedRating = button.dataset.rating || "all";
      ratingButtons.forEach((item) =>
        item.classList.toggle("active", item === button)
      );
      filterCards();
    });
  });

  searchInput?.addEventListener("input", filterCards);
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", sans-serif;
  }

  .page {
    width: min(1400px, calc(100% - 60px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 55px;
  }

  .collection {
    min-width: 0;
    padding-top: 38px;
  }

  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 42px;
    border-bottom: 1px solid #DCE8E8;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #7CB1D2;
    font: 12px monospace;
    letter-spacing: 0.13em;
  }

  .eyebrow span {
    margin: 0 8px;
    color: #A9C9D9;
  }

  h1 {
    margin: 0;
    color: #35495E;
    font-size: clamp(38px, 5vw, 54px);
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  .title-dot {
    color: #7CB1D2;
  }

  .subtitle {
    margin: 15px 0 0;
    color: #849A98;
    font-size: 14px;
    letter-spacing: 0.03em;
  }

  .collection-count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-bottom: 5px;
  }

  .count-number {
    color: #7CB1D2;
    font: 42px/1 monospace;
  }

  .count-label {
    margin-top: 8px;
    color: #A0B2B2;
    font: 10px monospace;
    letter-spacing: 0.12em;
  }

  .collection-tools {
    padding: 25px 0 20px;
    border-bottom: 1px solid #DCE8E8;
  }

  .filter-group,
  .rating-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .filter-button,
  .rating-button {
    padding: 8px 15px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
    color: #829494;
    font: 12px inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-button:hover,
  .rating-button:hover {
    color: #35495E;
    border-color: #CFE3EF;
  }

  .filter-button.active {
    border-color: #7CB1D2;
    background: #EAF4F8;
    color: #35495E;
  }

  .filter-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }

  .rating-button {
    padding: 6px 10px;
    font-size: 11px;
  }

  .rating-button.active {
    color: #5C8BA7;
    background: #F0F7FA;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 190px;
    padding: 7px 10px;
    border-bottom: 1px solid #CFE3EF;
    color: #7CB1D2;
  }

  .search-box span {
    font-size: 20px;
  }

  .search-box input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: #35495E;
    font: 12px inherit;
  }

  .search-box input::placeholder {
    color: #A5B6B5;
  }

  .result-bar {
    display: flex;
    justify-content: space-between;
    margin: 25px 0 18px;
    color: #A0B2B2;
    font: 10px monospace;
    letter-spacing: 0.12em;
  }

  .result-bar b {
    color: #7CB1D2;
    font-weight: 400;
  }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 34px 22px;
    min-height: 220px;
  }

  .poster-card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .poster-card:hover {
    transform: translateY(-5px);
  }

  .poster-card[hidden] {
    display: none;
  }

  .poster-image {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #EAF1F1;
  }

  .poster-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .poster-card:hover .poster-image img {
    transform: scale(1.035);
  }

  .poster-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    color: #8EAFBF;
    font: 11px monospace;
    letter-spacing: 0.15em;
  }

  .poster-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #35495E66;
    color: white;
    font: 10px monospace;
    letter-spacing: 0.12em;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .poster-card:hover .poster-overlay {
    opacity: 1;
  }

  .poster-rating {
    position: absolute;
    right: 9px;
    bottom: 9px;
    padding: 5px 8px;
    background: #F8FCFBEF;
    color: #5C8BA7;
    font: 11px monospace;
  }

  .poster-info {
    padding-top: 13px;
  }

  .poster-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: #91A7A7;
    font: 10px monospace;
  }

  .poster-info h2 {
    margin: 9px 0 0;
    overflow: hidden;
    color: #35495E;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    text-overflow: ellipsis;
  }

  .poster-info p {
    display: -webkit-box;
    overflow: hidden;
    margin: 5px 0 0;
    color: #9AAEAD;
    font-size: 11px;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .empty-state {
    display: flex;
    min-height: 280px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: #91A7A7;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-symbol {
    margin-bottom: 18px;
    color: #A9C9D9;
    font-size: 28px;
  }

  .empty-state p {
    margin: 0;
    color: #667F89;
    font-size: 14px;
  }

  .empty-state > span:last-child {
    margin-top: 12px;
    color: #B1C1C0;
    font: 10px monospace;
    letter-spacing: 0.12em;
  }

  .collection-footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 70px;
    padding: 20px 0;
    border-top: 1px solid #DCE8E8;
    color: #A2B4B3;
    font: 10px monospace;
    letter-spacing: 0.08em;
  }

  @media (max-width: 1100px) {
    .poster-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .page {
      width: calc(100% - 36px);
      padding: 25px 0;
      display: block;
    }

    .collection {
      padding-top: 35px;
    }

    .collection-header {
      padding-bottom: 30px;
    }

    .collection-count {
      display: none;
    }

    .filter-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .search-box {
      width: 100%;
    }

    .poster-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 14px;
    }

    .collection-footer {
      flex-direction: column;
      margin-top: 45px;
    }
  }
</style>
