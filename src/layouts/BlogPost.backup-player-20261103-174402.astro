}

.article-toc .toc-h3 {
  margin-left: 18px;
  color: #849A98 !important;
  font-size: 12px;
}

.floating-toc {
  padding: 12px 15px !important;
  border-left: 1px solid #CFE3EF !important;
  background: transparent !important;
}

.floating-toc-title {
  margin-bottom: 17px;
  color: #849A98;
  font-family: monospace;
  font-size: 10px;
  letter-spacing: .14em;
}

.floating-toc-list {
  display: grid;
  gap: 10px;
}

.floating-toc .toc-link {
  font-size: 12px;
}

.floating-toc .toc-h3 {
