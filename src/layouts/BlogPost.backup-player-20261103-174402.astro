  font-size: 17px;
}

.article-toc .toc-list {
  display: grid;
  gap: 10px;
  margin-top: 17px !important;
}

.article-toc .toc-link,
.floating-toc .toc-link {
  display: block;
  width: fit-content;
  color: #647B8D !important;
  font-size: 13px;
  line-height: 1.7;
  text-decoration: none !important;
  transition: color .2s ease, padding .2s ease;
}

.article-toc .toc-link:hover,
.article-toc .toc-link.active,
.floating-toc .toc-link:hover,
.floating-toc .toc-link.active {
  color: #7CB1D2 !important;
  text-decoration: none !important;
}

.article-toc .toc-link.active {
