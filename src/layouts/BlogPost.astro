<script>
document.querySelectorAll(".article-music-player").forEach((player) => {
  const audio = player.querySelector(".music-audio");
  const button = player.querySelector(".music-play");
  const icon = player.querySelector(".play-icon");
  const progress = player.querySelector(".music-progress");
  const current = player.querySelector(".music-current");
  const duration = player.querySelector(".music-duration");
  if (!audio || !button || !progress) return;

  const formatTime = (seconds) => {
    if (!Number.isFinite(seconds)) return "0:00";
    return Math.floor(seconds / 60) + ":" +
      String(Math.floor(seconds % 60)).padStart(2, "0");
  };

  audio.addEventListener("loadedmetadata", () => {
    duration.textContent = formatTime(audio.duration);
  });

  audio.addEventListener("timeupdate", () => {
    current.textContent = formatTime(audio.currentTime);
    if (Number.isFinite(audio.duration) && audio.duration > 0) {
      progress.value = audio.currentTime / audio.duration * 100;
    }
  });

  button.addEventListener("click", async () => {
    if (audio.paused) {
      try {
        await audio.play();
        icon.textContent = "Ⅱ";
        button.setAttribute("aria-label", "暂停");
      } catch (error) {
        console.error("音乐播放失败：", error);
      }
    } else {
      audio.pause();
    }
  });

  audio.addEventListener("pause", () => {
    icon.textContent = "▶";
    button.setAttribute("aria-label", "播放");
  });

  audio.addEventListener("ended", () => {
    progress.value = 0;
    current.textContent = "0:00";
  });

  progress.addEventListener("input", () => {
    if (Number.isFinite(audio.duration) && audio.duration > 0) {
      audio.currentTime = Number(progress.value) / 100 * audio.duration;
    }
  });
});
</script>

