    box-sizing: border-box;
  }

  :global(body) {
    position: relative;
    margin: 0;
    background: #F8FCFB;
    animation: pageFadeIn 0.7s ease both;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }


  :global(body)::after {
    content: "";
    position: fixed;
    right: 35px;
    bottom: 35px;
    width: 180px;
    height: 180px;
    background: url("/images/akisou-tanghulu.png") center / contain no-repeat;
