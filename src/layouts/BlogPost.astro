---
import Sidebar from "../components/Sidebar.astro";
import PageLoader from "../components/PageLoader.astro";
import FloatingTanghulu from "../components/FloatingTanghulu.astro";

const { title, date, description } = Astro.props;

const path = Astro.url.pathname;

const allPosts = Object.values(
  import.meta.glob("../pages/*/posts/*.md", {
    eager: true,
  })
);

const sortedPosts = allPosts
  .map((post) => post)
  .filter((post) => post?.frontmatter?.date)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  );

const currentIndex = sortedPosts.findIndex(
  (post) => post.url === Astro.url.pathname
);

const prevPost =
  currentIndex >= 0 ? sortedPosts[currentIndex + 1] : null;

const nextPost =
  currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const currentPost = allPosts.find(
  (post) => post.url === Astro.url.pathname
);

const music = Astro.props.frontmatter?.music;

const frontmatter = Astro.props.frontmatter || {};
const workType = frontmatter.type || "";

const workInfoFields = {
  movie: [
    ["导演", frontmatter.director],
    ["主演", frontmatter.cast],
    ["地区", frontmatter.region],
    ["上映日期", frontmatter.publishDate],
  ],
  tv: [
    ["导演", frontmatter.director],
    ["主演", frontmatter.cast],
    ["地区", frontmatter.region],
    ["集数", frontmatter.episodes],
    ["首播日期", frontmatter.publishDate],
  ],
  book: [
    ["作者", frontmatter.author],
    ["译者", frontmatter.translator],
    ["出版社", frontmatter.publisher],
    ["发行方", frontmatter.distributor],
    ["出版时间", frontmatter.publishDate],
    ["页数", frontmatter.pages],
  ],
  music: [
    ["艺人", frontmatter.artist],
    ["专辑", frontmatter.album],
    ["发行时间", frontmatter.publishDate],
    ["曲目", frontmatter.tracks],
  ],
  game: [
    ["开发商", frontmatter.developer],
    ["发行商", frontmatter.publisher],
    ["平台", frontmatter.platform],
    ["发行时间", frontmatter.publishDate],
  ],
};

const workInfo = workInfoFields[workType] || [];


const rawPosts = import.meta.glob("../pages/*/posts/*.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

const rawKey = Object.keys(rawPosts).find((key) => {
  const fileName = key.split("/").pop()?.replace(/\.md$/, "");
  const urlSlug = decodeURIComponent(
    Astro.url.pathname
      .split("/")
      .filter(Boolean)
      .pop() || ""
  );

  return fileName === urlSlug;
});

const rawContent = rawKey ? rawPosts[rawKey] : "";

const reviewSource = rawContent
  .replace(/^---[\s\S]*?---/, "")
  .trim();

const hasReview = reviewSource.length > 0;

const body = reviewSource.replace(/\s/g, "");

const wordCount = Array.from(body).length;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));



const category =
  path.startsWith("/travel/")
    ? "到处乱跑"
    : path.startsWith("/subtitles/")
      ? "听写小作坊"
      : path.startsWith("/works/")
        ? "书影音游"
        : "碎碎念";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title} / IZUMI</title>
  </head>

  <body>
  <script>
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const blur = target.closest(".blur-text");
      if (!blur) return;
      blur.classList.toggle("revealed");
    });
  </script>


    <PageLoader />
    <FloatingTanghulu />
    <main class="page">
      <Sidebar />

      <div class="article-main">
        <article>

        <div class="meta">
          <span>{category}</span>
          <span>{date}</span>
          <span>{readingTime} min read</span>
        </div>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        {path.startsWith("/works/") && (
          <>
            <section class="work-archive">
              {frontmatter.cover ? (
                <img
                  class="work-cover-image"
                  src={frontmatter.cover}
                  alt={`${title}封面`}
                />
              ) : (
                <div class="work-cover-placeholder">
                  <span>COVER</span>
                  <span>COMING SOON</span>
                </div>
              )}

              <div class="work-details">
                <div class="work-label">WORK INFORMATION</div>
                {frontmatter.originalTitle && (
                  <p class="work-original-title">
                    {frontmatter.originalTitle}
                  </p>
                )}
                <dl class="work-info-list">
                  {workInfo.filter((item) => item[1]).map(([label, value]) => (
                    <div class="work-info-row">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </section>
            <section class="my-review">
              <div class="review-heading">
                <span>MY REVIEW</span>
                <span>✳</span>
              </div>
              {hasReview ? (
                <div class="review-body">
                  <slot />
                </div>
              ) : (
                <p class="review-empty">还没有写下关于这部作品的感受。</p>
              )}
            </section>
          </>
        )}

        <div class="line"></div>

        {path.startsWith("/works/") ? null : (
          <div class="content">
            <slot />
          </div>
        )}

        <section class="comments" aria-label="评论区">
          <script
            src="https://giscus.app/client.js"
            data-repo="izumi1229/izumi1229.github.io"
            data-repo-id="R_kgDOU5pq2A"
            data-category="Announcements"
            data-category-id="DIC_kwDOU5pq2M4DHGGA"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="light"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </section>

      </article>



      <nav class="post-navigation" aria-label="文章导航">
        {prevPost ? (
          <a href={prevPost.url} class="post-nav prev">
            <span>← PREV</span>
            <strong>{prevPost.frontmatter.title}</strong>
          </a>
        ) : (
          <span></span>
        )}

        {nextPost ? (
          <a href={nextPost.url} class="post-nav next">
            <span>NEXT →</span>
            <strong>{nextPost.frontmatter.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>

      <a
        href={
          category === "到处乱跑"
            ? "/travel/"
            : category === "听写小作坊"
              ? "/subtitles/"
              : category === "书影音游"
                ? "/works/"
                : "/daily/"
        }
        class="back"
      >
        ← BACK TO {
          category === "到处乱跑"
            ? "TRAVEL"
            : category === "听写小作坊"
              ? "SUBTITLES"
              : category === "书影音游"
                ? "WORKS"
                : "DAILY"
        }
      </a>

        <footer class="site-footer">
        <p>This blog is live for <span id="blog-live-time">0 days, 0 hours, 0 mins</span> and counting.</p>
        <p>Copyright © 2026 IZUMI · 糖葫芦</p>
      </footer>
      </div>

    
      <aside class="floating-toc" id="floating-toc">
        {music?.src && (
          <section class="article-music-player">
            <div class="music-label">NOW PLAYING</div>
            <div class="music-title">{music.title || "未命名歌曲"}</div>
            {music.artist && <div class="music-artist">{music.artist}</div>}
            <audio class="music-audio" preload="metadata" src={music.src}></audio>
            <div class="music-controls">
              <button class="music-play" type="button" aria-label="播放">
                <span class="play-icon">▶</span>
              </button>
              <div class="music-timeline">
                <input class="music-progress" type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" />
                <div class="music-time">
                  <span class="music-current">0:00</span>
                  <span class="music-duration">0:00</span>
                </div>
              </div>
            </div>
          </section>
        )}
        <div class="floating-toc-title">ON THIS PAGE</div>
        <nav class="floating-toc-list" aria-label="章节导航"></nav>
      </aside>

    </main>
    <script>
    document.querySelectorAll(".content img").forEach((img) => {
      img.loading = "lazy";
      img.decoding = "async";
    });

    document.querySelectorAll(".content video").forEach((video) => {
      video.preload = "metadata";
    });
  </script>
  <script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const content = document.querySelector(".content");
  const floating = document.querySelector("#floating-toc");
  const sideList = floating?.querySelector(".floating-toc-list");

  if (!content || !floating || !sideList) return;

  const headings = Array.from(content.querySelectorAll("h2, h3"));
  if (!headings.length) {
    const tocTitle = floating.querySelector(".floating-toc-title");
    if (tocTitle) tocTitle.hidden = true;
    sideList.hidden = true;

    if (!floating.querySelector(".article-music-player")) {
      floating.hidden = true;
    }
    return;
  }

  let h2Count = 0;
  let h3Count = 0;
  const usedIds = new Set();

  headings.forEach((heading, index) => {
    if (!heading.id) heading.id = "article-section-" + (index + 1);

    let id = heading.id;
    let suffix = 2;
    while (usedIds.has(id)) id = heading.id + "-" + suffix++;
    heading.id = id;
    usedIds.add(id);

    let number;
    if (heading.tagName === "H2") {
      h2Count++;
      h3Count = 0;
      number = h2Count + ".";
    } else {
      h3Count++;
      number = h2Count + "." + h3Count + ".";
    }

    const link = document.createElement("a");
    link.href = "#" + heading.id;
    link.textContent = number + " " + heading.textContent.trim();
    link.className = heading.tagName === "H3" ? "toc-link toc-h3" : "toc-link";

    link.addEventListener("click", (event) => {
      event.preventDefault();
      heading.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", "#" + heading.id);

      links.forEach((item) => {
        item.classList.toggle("active", item === link);
      });
    });

    sideList.appendChild(link);
  });

  const links = Array.from(sideList.querySelectorAll("a"));

  let ticking = false;

  function updateActiveHeading() {
    const scrollPosition =
      window.scrollY + window.innerHeight * 0.30;

    let currentIndex = 0;

    headings.forEach((heading, index) => {
      const headingPosition =
        heading.getBoundingClientRect().top + window.scrollY;

      if (headingPosition <= scrollPosition) {
        currentIndex = index;
      }
    });

    links.forEach((link, index) => {
      link.classList.toggle("active", index === currentIndex);
    });

    ticking = false;
  }

  function requestUpdate() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActiveHeading);
  }

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);
  window.addEventListener("load", requestUpdate);

  // 兼容部分页面滚动事件未及时触发的情况
  const tocTimer = window.setInterval(updateActiveHeading, 200);

  updateActiveHeading();
});
</script>
</body>
</html>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("pre.astro-code").forEach((block) => {
      if (block.querySelector(".copy-code")) return;

      const button = document.createElement("button");
      button.className = "copy-code";
      button.textContent = "COPY";

      button.addEventListener("click", async () => {
        const code = block.querySelector("code")?.innerText || "";

        try {
          await navigator.clipboard.writeText(code);
          button.textContent = "COPIED";

          setTimeout(() => {
            button.textContent = "COPY";
          }, 1500);
        } catch {
          button.textContent = "FAILED";

          setTimeout(() => {
            button.textContent = "COPY";
          }, 1500);
        }
      });

      block.appendChild(button);
    });
  });
</script>


<style>
