<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>新建文章 · IZUMI ADMIN</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "PingFang SC",
        "Hiragino Sans",
        "Noto Sans JP",
        sans-serif;
      background:
        radial-gradient(circle at 8% 0%, rgba(124, 177, 210, 0.15), transparent 30%),
        radial-gradient(circle at 92% 8%, rgba(134, 197, 255, 0.11), transparent 28%),
        #f8fcfb;
      color: #35495e;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
      padding: 42px 0 70px;
    }

    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 30px;
    }

    .back {
      color: #7899aa;
      font-size: 13px;
      transition: 0.2s;
    }

    .back:hover {
      color: #5c91b1;
      transform: translateX(-2px);
    }

    .eyebrow {
      margin: 0 0 7px;
      color: #7cb1d2;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
    }

    h1 {
      margin: 0;
      color: #35495e;
      font-size: 34px;
      letter-spacing: -0.04em;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 20px;
      align-items: start;
    }

    .panel {
      border: 1px solid rgba(207, 227, 239, 0.95);
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 14px 40px rgba(124, 177, 210, 0.08);
      backdrop-filter: blur(12px);
    }

    .editor {
      padding: 24px;
    }

    .field {
      margin-bottom: 20px;
    }

    .field:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #587083;
      font-size: 12px;
      font-weight: 700;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #d5e6ee;
      border-radius: 12px;
      outline: none;
      background: rgba(248, 252, 253, 0.9);
      color: #35495e;
      transition: 0.2s;
    }

    input,
    select {
      height: 45px;
      padding: 0 13px;
    }

    textarea {
      min-height: 530px;
      padding: 16px;
      resize: vertical;
      line-height: 1.8;
      font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        monospace;
      font-size: 13px;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #7cb1d2;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(124, 177, 210, 0.1);
    }

    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .side {
      padding: 20px;
      position: sticky;
      top: 20px;
    }

    .side-title {
      margin: 0 0 15px;
      font-size: 15px;
      color: #35495e;
    }

    .tools {
      display: grid;
      gap: 9px;
    }

    .tool {
      position: relative;
      overflow: hidden;
      width: 100%;
      min-height: 44px;
      border: 1px solid #d5e6ee;
      border-radius: 12px;
      background: #f8fcfd;
      color: #5f8297;
      cursor: pointer;
      text-align: left;
      padding: 0 13px;
      transition: 0.2s;
    }

    .tool:hover {
      border-color: #7cb1d2;
      background: #fff;
      transform: translateY(-1px);
    }

    .tool input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .help {
      margin: 20px 0 0;
      padding-top: 18px;
      border-top: 1px solid #e4eef2;
      color: #8a9da4;
      font-size: 11px;
      line-height: 1.8;
    }

    .publish {
      width: 100%;
      height: 48px;
      margin-top: 20px;
      border: 0;
      border-radius: 13px;
      background: #7cb1d2;
      color: white;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 9px 22px rgba(124, 177, 210, 0.22);
      transition: 0.2s;
    }

    .publish:hover {
      background: #6ba5c9;
      transform: translateY(-2px);
    }

    .publish:disabled {
      opacity: 0.55;
      cursor: wait;
      transform: none;
    }

    .status {
      display: none;
      margin-top: 12px;
      padding: 11px 13px;
      border-radius: 11px;
      background: #edf7fb;
      color: #64869a;
      font-size: 12px;
      line-height: 1.6;
    }

    .status.show {
      display: block;
    }

    .status.error {
      background: #fff3f1;
      color: #b46d63;
    }

    .status.success {
      background: #eef8f3;
      color: #62927b;
    }

    .insert-tip {
      margin-top: 8px;
      color: #98a8ad;
      font-size: 10px;
      line-height: 1.6;
    }

    @media (max-width: 800px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .side {
        position: static;
      }

      textarea {
        min-height: 420px;
      }
    }

    @media (max-width: 560px) {
      .page {
        width: min(100% - 22px, 560px);
        padding-top: 28px;
      }

      .top {
        align-items: flex-start;
      }

      h1 {
        font-size: 28px;
      }

      .meta {
        grid-template-columns: 1fr;
      }

      .editor,
      .side {
        padding: 17px;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <header class="top">
      <div>
        <p class="eyebrow">IZUMI ADMIN</p>
        <h1>新建文章</h1>
      </div>

      <a class="back" href="/admin">← 返回后台</a>
    </header>

    <div class="layout">
      <section class="panel editor">
        <form id="postForm">
          <div class="field">
            <label for="title">标题</label>
            <input
              id="title"
              name="title"
              type="text"
              placeholder="写下这篇文章的标题……"
              required
            />
          </div>

          <div class="meta">
            <div class="field">
              <label for="category">分类</label>
              <select id="category" name="category" required>
                <option value="碎碎念">碎碎念</option>
                <option value="到处乱跑">到处乱跑</option>
                <option value="听写小作坊">听写小作坊</option>
                <option value="书影音游">书影音游</option>
              </select>
            </div>

            <div class="field">
              <label for="date">日期</label>
              <input id="date" name="date" type="date" required />
            </div>
          </div>

          <div class="field">
            <label for="description">文章简介</label>
            <input
              id="description"
              name="description"
              type="text"
              placeholder="首页卡片会显示的简短介绍……"
            />
          </div>

          <div class="field cover-field">
            <label for="coverInput">文章封面</label>

            <div class="cover-upload">
              <input
                id="coverInput"
                type="file"
                accept="image/*"
              />

              <div id="coverPreview" class="cover-preview">
                <span>选择一张图片作为文章封面</span>
              </div>
            </div>

            <button
              class="cover-remove"
              id="removeCoverButton"
              type="button"
              hidden
            >
              移除封面
            </button>
          </div>

          <div class="field">
            <label for="content">正文</label>
            <textarea
              id="content"
              name="content"
              placeholder="从这里开始写……

支持 Markdown。

可以使用右侧按钮上传图片或视频。"
              required
            ></textarea>
          </div>
        </form>
      </section>

      <aside class="panel side">
        <h2 class="side-title">插入媒体</h2>

        <div class="tools">
          <button class="tool" type="button" id="imageButton">
            🖼️ 上传图片
            <input id="imageInput" type="file" accept="image/*" />
          </button>

          <button class="tool" type="button" id="videoButton">
            🎬 上传视频
            <input
              id="videoInput"
              type="file"
              accept="video/mp4,video/webm,video/quicktime"
            />
          </button>
        </div>

        <p class="insert-tip">
          上传完成后，Markdown 会自动插入到当前光标位置。
        </p>

        <button class="publish" id="publishButton" type="button">
          发布文章
        </button>

        <div class="status" id="status"></div>

        <p class="help">
          发布后会自动创建文章文件，并执行 Git commit + push。
        </p>
      </aside>
    </div>
  </main>

  <script>
    const form = document.querySelector("#postForm");
    const title = document.querySelector("#title");
    const category = document.querySelector("#category");
    const date = document.querySelector("#date");
    const description = document.querySelector("#description");
    const content = document.querySelector("#content");

    const coverInput = document.querySelector("#coverInput");
    const coverPreview = document.querySelector("#coverPreview");
    const removeCoverButton = document.querySelector("#removeCoverButton");
    let coverUrl = "";

    const imageInput = document.querySelector("#imageInput");
    const videoInput = document.querySelector("#videoInput");
    const imageButton = document.querySelector("#imageButton");
    const videoButton = document.querySelector("#videoButton");
    const publishButton = document.querySelector("#publishButton");
    const status = document.querySelector("#status");

    function today() {
      const now = new Date();
      const offset = now.getTimezoneOffset();
      return new Date(now.getTime() - offset * 60000)
        .toISOString()
        .slice(0, 10);
    }

    date.value = today();

    function showStatus(message, type = "") {
      status.textContent = message;
      status.className = "status show " + type;
    }

    function insertAtCursor(text) {
      const start = content.selectionStart;
      const end = content.selectionEnd;

      content.value =
        content.value.slice(0, start) +
        text +
        content.value.slice(end);

      const position = start + text.length;

      content.focus();
      content.selectionStart = position;
      content.selectionEnd = position;
    }

    async function uploadCover(file) {
      if (!file) return;

      showStatus("正在上传封面……");

      try {
        const reader = new FileReader();

        const fileData = await new Promise((resolve, reject) => {
          reader.onload = () => resolve(reader.result);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });

        const response = await fetch("/api/upload-image", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            fileName: file.name,
            fileData,
          }),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "封面上传失败");
        }

        coverUrl = result.url;

        coverPreview.innerHTML = `
          <img src="${result.url}" alt="文章封面预览" />
        `;

        removeCoverButton.hidden = false;
        showStatus("封面上传成功。", "success");
      } catch (error) {
        console.error(error);
        showStatus(error.message || "封面上传失败。", "error");
      }
    }

    coverInput.addEventListener("change", () => {
      const file = coverInput.files?.[0];
      uploadCover(file);
    });

    removeCoverButton.addEventListener("click", () => {
      coverUrl = "";
      coverInput.value = "";
      coverPreview.innerHTML = "<span>选择一张图片作为文章封面</span>";
      removeCoverButton.hidden = true;
      showStatus("已移除封面。");
    });

    async function uploadFile(file, type) {
      if (!file) return;

      showStatus(type === "image" ? "正在上传图片……" : "正在上传视频……");

      try {
        const reader = new FileReader();

        const fileData = await new Promise((resolve, reject) => {
          reader.onload = () => resolve(reader.result);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });

        const response = await fetch(
          type === "image"
            ? "/api/upload-image"
            : "/api/upload-video",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              fileName: file.name,
              fileData,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "上传失败");
        }

        if (type === "image") {
          insertAtCursor(`\n![${result.fileName}](${result.url})\n`);
          showStatus("图片已上传并插入正文。", "success");
        } else {
          insertAtCursor(
            `\n<video controls preload="metadata" src="${result.url}"></video>\n`
          );
          showStatus("视频已上传并插入正文。", "success");
        }
      } catch (error) {
        console.error(error);
        showStatus(error.message || "上传失败，请重试。", "error");
      }
    }

    imageInput.addEventListener("change", async () => {
      await uploadFile(imageInput.files[0], "image");
      imageInput.value = "";
    });

    videoInput.addEventListener("change", async () => {
      await uploadFile(videoInput.files[0], "video");
      videoInput.value = "";
    });

    imageButton.addEventListener("click", (event) => {
      if (event.target === imageInput) return;
      imageInput.click();
    });

    videoButton.addEventListener("click", (event) => {
      if (event.target === videoInput) return;
      videoInput.click();
    });

    publishButton.addEventListener("click", async () => {
      if (!title.value.trim()) {
        showStatus("请先填写标题。", "error");
        title.focus();
        return;
      }

      if (!date.value) {
        showStatus("请选择日期。", "error");
        date.focus();
        return;
      }

      if (!content.value.trim()) {
        showStatus("正文不能为空。", "error");
        content.focus();
        return;
      }

      publishButton.disabled = true;
      publishButton.textContent = "正在发布……";
      showStatus("正在创建文章并推送到 GitHub……");

      try {
        const response = await fetch("/api/publish", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            title: title.value.trim(),
            category: category.value,
            date: date.value,
            description: description.value.trim(),
            cover: coverUrl,
            content: content.value,
          }),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "发布失败");
        }

        showStatus(
          "发布成功！文章已经写入博客。正在打开文章……",
          "success"
        );

        setTimeout(() => {
          window.open(result.url, "_blank");
        }, 700);
      } catch (error) {
        console.error(error);
        showStatus(error.message || "发布失败，请检查 Git 状态。", "error");
        publishButton.disabled = false;
        publishButton.textContent = "发布文章";
      }
    });
  </script>
</body>
</html>
